{
  "uid": "homelab-logs",
  "title": "Logs and Events",
  "description": "Loki, from the top down: how much is being logged, by whom, at what level, and then the lines themselves. Every pod ships here automatically.",
  "tags": [
    "homelab",
    "logs"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "graphTooltip": 1,
