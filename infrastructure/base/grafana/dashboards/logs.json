        "label": "Pod",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": "label_values({namespace=~\"$namespace\"}, pod)",
        "definition": "label_values({namespace=~\"$namespace\"}, pod)",
        "regex": "",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": null,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
