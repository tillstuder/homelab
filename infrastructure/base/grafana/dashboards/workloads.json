    {
      "type": "timeseries",
      "title": "CPU Throttling",
      "description": "Share of scheduling periods the container was throttled. Only pods with a CPU limit can throttle.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
