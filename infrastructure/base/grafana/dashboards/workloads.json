  "timepicker": {},
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "namespace",
        "label": "Namespace",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(container_cpu_usage_seconds_total{container!=\"\"}, namespace)",
        "definition": "label_values(container_cpu_usage_seconds_total{container!=\"\"}, namespace)",
        "regex": "",
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "allValue": null,
        "current": {
          "text": "monitoring",
          "value": "monitoring"
        },
        "options": [],
        "hide": 0
      },
      {
        "type": "query",
        "name": "pod",
        "label": "Pod",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(container_cpu_usage_seconds_total{container!=\"\",namespace=\"$namespace\"}, pod)",
        "definition": "label_values(container_cpu_usage_seconds_total{container!=\"\",namespace=\"$namespace\"}, pod)",
        "regex": "",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": null,
