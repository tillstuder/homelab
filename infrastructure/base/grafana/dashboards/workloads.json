{
  "uid": "homelab-workloads",
  "title": "Workloads",
  "description": "Per-namespace pod resource usage, restarts and controller health. Pick a namespace at the top.",
  "tags": [
    "homelab",
    "kubernetes"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "1m",
  "graphTooltip": 1,
  "time": {
