    {
      "type": "timeseries",
      "title": "CPU Against Requests and Limits",
      "description": "Requests drive scheduling, limits drive throttling. This repo mostly sets requests on CPU and limits on memory.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
