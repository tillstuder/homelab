{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits"
  ],
  "timezone": "Europe/Zurich",
  "argocd": {
    "managerFilePatterns": ["/clusters/.+/(platform|apps)/.+\\.yaml$/"]
  },
  "packageRules": [
    {
      "description": "DEV soaks everything first, merge without asking.",
      "matchFileNames": ["clusters/dev/**"],
      "automerge": true,
      "minimumReleaseAge": "0 days",
      "commitMessagePrefix": "dev:"
    },
    {
      "description": "PROD only after the release has aged and DEV has run it.",
      "matchFileNames": ["clusters/prod/**"],
      "automerge": false,
      "minimumReleaseAge": "7 days",
      "commitMessagePrefix": "prod:"
    },
    {
      "description": "Shared base manifests reach prod immediately, so they get prod rules.",
      "matchFileNames": ["apps/base/**", "infrastructure/base/**"],
      "automerge": false,
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Talos and Kubernetes versions are never automerged.",
      "matchFileNames": ["talos/**"],
      "automerge": false,
      "minimumReleaseAge": "14 days"
    },
    {
      "description": "OpenTofu versions are never automerged.",
      "matchFileNames": ["tofu/**"],
      "automerge": false,
      "minimumReleaseAge": "14 days",
      "commitMessagePrefix": "tofu:"
    }
  ],
  "customManagers": [
    {
      "description": "Talos + Kubernetes versions in talenv.yaml",
      "customType": "regex",
      "managerFilePatterns": ["/talos/talenv\\.yaml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+\\w+:\\s*\"?(?<currentValue>[^\"\\s]+)\"?"
      ]
    },
    {
      "description": "Container images in raw manifests, tag + digest",
      "customType": "regex",
      "managerFilePatterns": ["/^(apps|infrastructure)/.+\\.yaml$/"],
      "matchStrings": [
        "image:\\s+(?<depName>[^:@\\s]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    }
  ]
}
