{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    ':dependencyDashboard',
    ':semanticCommits',
  ],
  timezone: 'Europe/Zurich',
  schedule: ['* 0-6 * * *'],
  // The `argocd` manager parses Application/ApplicationSet manifests natively and
  // bumps `spec.source(s).targetRevision` for Helm chart sources. It ships with no
  // default file pattern at all — without `managerFilePatterns` the manager matches
  // nothing, so this block is required rather than a refinement of a default.
  argocd: {
    managerFilePatterns: ['/clusters/.+/(platform|apps)/.+\\.yaml$/'],
  },
  packageRules: [
    {
      // Automerge stays PR-based on purpose. `automergeType: 'branch'` would push
      // straight to a `renovate/*` branch and merge without opening a PR, and
      // `.github/workflows/validate.yaml` only triggers on `pull_request` and on
      // pushes to `main` — so nothing would ever run `scripts/validate.sh` before
      // the merge landed, and Renovate would read "no checks" as green.
      description: 'DEV soaks everything first, merge without asking.',
      matchFileNames: ['clusters/dev/**'],
      automerge: true,
      minimumReleaseAge: '0 days',
      commitMessagePrefix: 'dev:',
    },
    {
      description: 'PROD only after the release has aged and DEV has run it.',
      matchFileNames: ['clusters/prod/**'],
      automerge: false,
      minimumReleaseAge: '7 days',
      commitMessagePrefix: 'prod:',
    },
    {
      // `base/` is kustomized by both overlays, so a bump here reaches prod on the
      // same merge that reaches dev — there is no dev-first soak to lean on. Give
      // it prod's caution instead of the default (no aging, no review).
      description: 'Shared base manifests reach prod immediately, so they get prod rules.',
      matchFileNames: ['apps/base/**', 'infrastructure/base/**'],
      automerge: false,
      minimumReleaseAge: '7 days',
    },
    {
      description: 'Talos and Kubernetes versions are never automerged.',
      matchFileNames: ['talos/**'],
      automerge: false,
      minimumReleaseAge: '14 days',
    },
    {
      // Picked up by the built-in `terraform` manager, which parses
      // `required_providers` in every .tf file. These providers build and destroy
      // the machines the clusters run on, and a bad bump is not something Argo can
      // roll back, so they get the same caution as prod and are never automerged.
      description: 'OpenTofu providers build the clusters themselves.',
      matchFileNames: ['tofu/**'],
      automerge: false,
      minimumReleaseAge: '14 days',
      commitMessagePrefix: 'tofu:',
    },
  ],
  customManagers: [
    {
      description: 'Talos + Kubernetes versions in talenv.yaml',
      customType: 'regex',
      managerFilePatterns: ['/talos/talenv\\.yaml$/'],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+\\w+:\\s*"?(?<currentValue>[^"\\s]+)"?',
      ],
    },
    {
      // Images we declare ourselves are pinned `repo:tag@sha256:...`, so the
      // digest has to be captured or Renovate would bump the tag and leave a
      // stale digest pointing at the old image.
      //
      // A regex rather than the native `kubernetes` manager because one of
      // these images lives inside a ConfigMap string (the local-path helper
      // pod), which a structured parser cannot see.
      description: 'Container images in raw manifests, tag + digest',
      customType: 'regex',
      managerFilePatterns: ['/^(apps|infrastructure)/.+\\.yaml$/'],
      matchStrings: [
        'image:\\s+(?<depName>[^:@\\s]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})',
      ],
      datasourceTemplate: 'docker',
    },
  ],
}
